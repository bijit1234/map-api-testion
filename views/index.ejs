<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coal Mine Map</title>
</head>
<body>
    <section>
        <h1>Welcome to the Coal API Authentication Example</h1>
        <p>This is a simple example of how to implement authentication in a Node.js application using the Coal API.</p> 
        <% mines.forEach(mine => { %>
            <h2><%= mine.name %></h2>
            <p>Location: <%= mine.location %></p>
            <p>Latitude: <%= mine.latitude %></p>
            <p>Longitude: <%= mine.longitude %></p>
            <p>Status: <%= mine.status %></p>

            <hr>

        <% }) %>
    </section> 
    <a href="/map">
    <button>View Map</button>
    </a>   
</body>
</html>